# --- Cerebro (LLM): elige uno ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# AVATARHYPE_LLM=anthropic   # fuerza proveedor (anthropic|openai)

# --- Motores de generación (rellena los de la ruta que uses) ---
# APImart (apimart.ai) — ruta del curso, la más barata
APIMART_API_KEY=
# APIMART_BASE_URL=https://api.apimart.ai

# Kie.ai — ruta alternativa (Sora 2, etc.)
KIE_API_KEY=
# KIE_BASE_URL=https://api.kie.ai

# Higgsfield — para comparar coste/calidad
HIGGSFIELD_API_KEY=
# HIGGSFIELD_BASE_URL=https://api.higgsfield.ai

# ElevenLabs — voz en off (formato UGC voz off)
ELEVENLABS_API_KEY=

# --- Skool (extractor de comunidad) ---
# Pega el valor COMPLETO de la cabecera `cookie:` de una petición a skool.com
# estando logueado. Autentica como tú (miembro pagado). NO se commitea (.env ignorado).
SKOOL_COOKIE=
# Alternativa: ruta a un fichero local con la cookie (gitignored)
# SKOOL_COOKIE_FILE=/ruta/local/skool_cookie.txt
# URL de la comunidad a extraer
SKOOL_COMMUNITY_URL=

# --- Pipeline ---
# AVATARHYPE_RUTA=apimart            # apimart|kie|higgsfield
# AVATARHYPE_MODELO_VIDEO=omni-flash
# AVATARHYPE_OUT=output
