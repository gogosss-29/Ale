# --- Cerebro (LLM): elige uno ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# AVATARHYPE_LLM=anthropic   # fuerza proveedor (anthropic|openai)

# --- Motores de generación (rellena los de la ruta que uses) ---
# Google (Gemini/Veo) — ruta de Alexander (Omni Flash = Veo 3.1). API oficial,
# más cara por clip que APImart pero usa su mismo modelo de AI Studio.
GEMINI_API_KEY=
# GOOGLE_API_KEY=                    # alternativa a GEMINI_API_KEY

# APImart (apimart.ai) — ruta del curso, la más barata (para volumen)
APIMART_API_KEY=
# APIMART_BASE_URL=https://api.apimart.ai

# Kie.ai — ruta alternativa (Sora 2, etc.)
KIE_API_KEY=
# KIE_BASE_URL=https://api.kie.ai

# Higgsfield — para comparar coste/calidad
HIGGSFIELD_API_KEY=
# HIGGSFIELD_BASE_URL=https://api.higgsfield.ai

# ElevenLabs — TU voz clonada (doblaje de los anuncios con tu voz real)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=             # id de tu voz clonada (se crea 1 vez con tus clips)

# --- Pipeline ---
# AVATARHYPE_RUTA=google             # google|apimart|kie|higgsfield
# AVATARHYPE_MODELO_VIDEO=veo-3.1-fast-generate-preview
# AVATARHYPE_OUT=output
