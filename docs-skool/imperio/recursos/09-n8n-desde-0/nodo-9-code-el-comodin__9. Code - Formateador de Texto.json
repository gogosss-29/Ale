    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  if (item.json.nombre && typeof item.json.nombre === 'string') {\n    item.json.nombre = item.json.nombre\n      .trim()                 // quita espacios al inicio y al final\n      .replace(/\\s+/g, ' ')   // colapsa múltiples espacios internos\n      .toLowerCase()          // todo a minúscula\n      .replace(/\\b\\w/g, c => c.toUpperCase()); // primera letra de cada palabra en mayúscula\n  }\n\n  return item;\n});\n"
      },
      "type": "n8n-nodes-base.code",
