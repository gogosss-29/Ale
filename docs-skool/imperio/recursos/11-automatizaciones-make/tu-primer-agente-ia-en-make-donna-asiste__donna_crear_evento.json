    "io": {
        "input_spec": [
            {
                "help": "inicio de la fecha del periodo en formato DD.MM.YYYY HH:mm",
                "name": "fecha_inicio",
                "type": "text",
                "label": "",
                "default": "00:00",
                "required": true,
                "multiline": false
            },
            {
                "help": "termino de la fecha del periodo en formato DD.MM.YYYY HH:mm (si no la tenemos pero tenemos la duracion, podemos hacer fecha_inicio + duracion)",
                "name": "fecha_termino",
                "type": "text",
                "label": "",
                "default": "23:59",
                "required": false,
                "multiline": false
            },
            {
                "help": "nombre del evento a crear",
                "name": "nombre_evento",
                "type": "text",
                "label": "",
